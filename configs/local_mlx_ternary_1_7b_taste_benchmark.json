{
  "name": "local-mlx-ternary-1-7b-taste-benchmark",
  "dataset_dir": "artifacts/datasets/learning-app-taste-qwen25coder-3b",
  "output_dir": "artifacts/benchmarks/local-mlx-ternary-1-7b-taste",
  "generation": {
    "max_tokens": 1400,
    "temperature": 0.2,
    "top_p": 0.95,
    "top_k": 40,
    "seed": 42,
    "local_transport": "in_process"
  },
  "evaluation": {
    "run_render": true,
    "max_cases": 2,
    "render_quality": "low",
    "max_render_seconds": 90,
    "allowed_render_regression": 0.05,
    "min_loss_delta": 0.01,
    "tie_loss_delta": 0.003,
    "metric_weights": {
      "syntax": 0.25,
      "scene_class": 0.15,
      "required_snippets": 0.25,
      "forbidden_snippets": 0.05,
      "render": 0.3
    }
  },
  "targets": [
    {
      "name": "local-finetuned-qwen25coder-3b",
      "backend": "local",
      "model": "Qwen/Qwen2.5-Coder-3B-Instruct",
      "adapter_path": "artifacts/adapters/m4-max-qwen25coder-3b"
    },
    {
      "name": "ternary-bonsai-1-7b-2bit",
      "backend": "local",
      "model": "prism-ml/Ternary-Bonsai-1.7B-mlx-2bit"
    }
  ]
}

{
  "name": "local-mlx-small-coder-taste-benchmark",
  "dataset_dir": "artifacts/datasets/learning-app-taste-qwen25coder-3b",
  "output_dir": "artifacts/benchmarks/local-mlx-small-coder-taste",
  "generation": {
    "max_tokens": 1400,
    "temperature": 0.2,
    "top_p": 0.95,
    "top_k": 40,
    "seed": 7,
    "local_transport": "in_process"
  },
  "evaluation": {
    "run_render": true,
    "max_cases": 2,
    "render_quality": "low",
    "max_render_seconds": 90,
    "metric_weights": {
      "syntax": 0.25,
      "scene_class": 0.15,
      "required_snippets": 0.25,
      "forbidden_snippets": 0.05,
      "render": 0.3
    }
  },
  "targets": [
    {
      "name": "current-finetuned-qwen25coder-3b",
      "backend": "local",
      "model": "Qwen/Qwen2.5-Coder-3B-Instruct",
      "adapter_path": "artifacts/adapters/m4-max-qwen25coder-3b"
    },
    {
      "name": "qwen25coder-1p5b-instruct-4bit",
      "backend": "local",
      "model": "mlx-community/Qwen2.5-Coder-1.5B-Instruct-4bit"
    },
    {
      "name": "finetuned-qwen25coder-1p5b-targeted",
      "backend": "local",
      "model": "mlx-community/Qwen2.5-Coder-1.5B-Instruct-4bit",
      "adapter_path": "artifacts/adapters/qwen25coder-1p5b-targeted-refresh"
    },
    {
      "name": "finetuned-qwen25coder-1p5b-short-curriculum",
      "backend": "local",
      "model": "mlx-community/Qwen2.5-Coder-1.5B-Instruct-4bit",
      "adapter_path": "artifacts/adapters/qwen25coder-1p5b-short-curriculum"
    },
    {
      "name": "qwen25coder-0p5b-instruct-4bit",
      "backend": "local",
      "model": "mlx-community/Qwen2.5-Coder-0.5B-Instruct-4bit"
    }
  ]
}
